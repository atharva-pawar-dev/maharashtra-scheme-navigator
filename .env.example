APP_ENV=local
APP_NAME=Scheme Navigator
LOG_LEVEL=INFO
# Keep personal data transient. Do not use real Aadhaar numbers in demo/testing.
DATA_RETENTION_HOURS=24

# Security and Cryptographic Keys (Must be >= 32 characters in production)
# Secret key for HMAC citizen session and reviewer token signing
SCHEME_NAVIGATOR_AUTH_SECRET=
# One-time bootstrap key for initial administrator provisioning via POST /admin/auth/provision
ADMIN_BOOTSTRAP_KEY=
# Secret key for signing verified catalogue releases via POST /admin/catalogue/sign-release
CATALOGUE_RELEASE_SIGNING_KEY=
# Lifetime in hours for privileged sessions (Analyst, Legal Reviewer, Admin)
PRIVILEGED_SESSION_TTL_HOURS=1

# Document Vision Extraction (Google Gemini)
GEMINI_API_KEY=

# Local Ollama-compatible endpoint. Compiler must never auto-activate generated rules.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
VISION_MODEL=qwen2.5vl:7b

# Optional semantic retrieval backend; BM25/local retrieval remains available without it.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=scheme_sources
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Persistent SQLite database locations
INTERVIEW_DB_PATH=data/interviews.sqlite3
DOCUMENT_REVIEW_DB_PATH=data/document_reviews.sqlite3
INGESTION_DB_PATH=data/ingestion.sqlite3

# Never set this to a government domain. Worker code only permits loopback hosts.
MOCK_FORM_URL=http://127.0.0.1:8000/demo-form

# Voice: local Whisper (install `pip install -e '.[voice]'`) or Bhashini ULCA (explicit cloud consent required).
WHISPER_MODEL_SIZE=small
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
