  "sources": [
    {
      "source_name": "Maharashtra GR No. Sankirna-2024/CR137/Karya-02 (Base GR)",
      "source_url": "https://gr.maharashtra.gov.in/Site/Upload/GR/202406281814018230.pdf",
      "source_kind": "government_resolution",
      "retrieved_at": "2026-11-08T00:00:00",
      "evidence_excerpt": "शासन निर्णय: राज्यातील २१ ते ६५ वर्षे वयोगटातील पात्र महिलांना दरमहा रु. १५००/- थेट बँक खात्यात (DBT) आर्थिक लाभ देण्यात येईल. कुटुंब वार्षिक उत्पन्न मर्यादा रु. २.५० लाख राहील.",
      "evidence_sha256": "4c82a8b88a21b06042f46382b23d1327c8fa37a1eacefadbc9ca66778f0093fd",
      "page_or_section": "Para 1-3"
    },
    {
      "source_name": "Maharashtra GR No. Sankirna-2024/CR137/Karya-02 (Shuddhipatra)",
      "source_url": "https://gr.maharashtra.gov.in/Site/Upload/GR/202407031335114330.pdf",
      "source_kind": "government_resolution",
      "retrieved_at": "2026-11-08T00:00:00",
      "evidence_excerpt": "शुद्धीपत्रक दिनांक ०३ जुलै २०२४: वयोमर्यादा २१ ते ६० ऐवजी २१ ते ६५ वर्षे करण्यात येत आहे. अधिवास प्रमाणपत्राऐवजी १५ वर्षांपूर्वीचे रेशन कार्ड, मतदार ओळखपत्र, शाळा सोडल्याचा दाखला किंवा जन्म दाखला ग्राह्य राहील.",
      "evidence_sha256": "69f6b4dc283f7721c2e4adc1d62262df21213e7413fb739406d1470ccc08df40",
      "page_or_section": "Para 1-4"
    },
    {
      "source_name": "Maharashtra GR No. Sankirna-2024/CR137/Karya-02 (Clarification GR)",
      "source_url": "https://gr.maharashtra.gov.in/Site/Upload/GR/202407121401594230.pdf",
      "source_kind": "government_resolution",
      "retrieved_at": "2026-11-08T00:00:00",
      "evidence_excerpt": "शासन निर्णय दिनांक १२ जुलै २०२४: पिवळे अथवा केशरी रेशनकार्डधारक कुटुंबांना स्वतंत्र उत्पन्नाच्या दाखल्याची आवश्यकता असणार नाही. परराज्यात जन्मलेल्या मात्र महाराष्ट्रातील अधिवास असलेल्या पुरुषाशी विवाह झालेल्या महिला पात्र राहतील.",
      "evidence_sha256": "f39fcfbbe8ff299d4cb7752860fe22e8564a235c939b4c21111880744df134cd",
      "page_or_section": "Clauses 1-4"
    },
    {
      "source_name": "Official Ladki Bahin Portal (WCD Maharashtra)",
      "source_url": "https://ladakibahin.maharashtra.gov.in/",
      "source_kind": "official_portal",
      "retrieved_at": "2026-11-08T00:00:00",
      "evidence_excerpt": "मुख्यमंत्री - माझी लाडकी बहीण योजना अधिकृत संकेतस्थळ (ladakibahin.maharashtra.gov.in): अर्जदाराचे आधार लिंक बँक खाते असणे अनिवार्य आहे. इतर शासकीय योजनेतून रु. १५०० किंवा अधिक लाभ घेणाऱ्या महिला अपात्र राहतील.",
      "evidence_sha256": "ed8d389579fccc0ef31cb0029fe6ba42836f844cab3bb239dd495bc690e7e608",
      "page_or_section": "Guidelines & FAQ"
    }
  ],
