{
  "scheme_id": "candidate-post-matric-obc-girls-professional",
  "name": "Post Matric Scholarship to the Girls Belonging to OBC taking admission in Professional Courses (व्यावसायिक अभ्यासक्रमास प्रवेश घेणाऱ्या इतर मागास प्रवर्गातील मुलींना मॅट्रिकोत्तर शिष्यवृत्ती)",
  "department": "Other Backward Bahujan Welfare Department, Government of Maharashtra",
  "summary": "Provides 100% scholarship covering tuition fees, examination fees, and monthly maintenance allowance to female OBC students in professional courses with parental annual income up to Rs. 2.5 Lakh. (DRAFT CANDIDATE - NON-PRODUCTION)",
  "benefits": [
    "100% Tuition Fee and Examination Fee reimbursement",
    "Monthly maintenance allowance to support academic and living expenses",
    "Hosteller allowance (1/3rd of standard rate if residing in a government hostel)"
  ],
  "required_documents": [
    "OBC Caste Certificate issued by competent revenue authority",
    "Valid Non-Creamy Layer (NCL) Certificate",
    "Income Certificate (<= Rs. 2,50,000) issued by Tahsildar",
    "Maharashtra Domicile Certificate",
    "College admission receipt and Bonafide Certificate in a recognized professional course",
    "Previous year marksheet",
    "Aadhaar-linked bank account passbook"
  ],
